{
  "name": "eqconnect-monorepo",
  "version": "0.1.0",
  "description": "EqConnect — India's Fair Student Ecosystem",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "preview": "npm run preview --workspace=client",
    "start": "npm start --workspace=server"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "concurrently": "^8.2.2"
  }
}
